# Backend local/deployment environment (never commit real secrets)
PORT=5000
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=eleave_db
DB_SSL=true
# Optional: paste the Aiven CA certificate here; preserve newlines as \n if needed.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_CONNECT_TIMEOUT=20000
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://your-frontend.vercel.app
# Optional additional comma-separated origins:
# CLIENT_URLS=https://another-domain.vercel.app,http://localhost:5173
